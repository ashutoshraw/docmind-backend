PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (free M0 cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/docmind

# Generate strong random secrets, e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Your frontend's URL (Vite default shown)
CLIENT_URL=http://localhost:5173
